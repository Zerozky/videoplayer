/* 窗口背景 */
QWidget, QFrame {
    background-color: #f2f6fa;
    color: #333;
}
/* 标题栏背景（淡灰蓝渐变） */
QWidget#titleBar {
    border-bottom: 1px solid #a0a0a0; /* 为标题栏底部添加边框 */
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #e8edf2, stop:1 #c8d4e0);
}

/* 分割条 */
QSplitter {
    background-color: #323232;
    border: none;
}

/* 扁平化按钮 */
QPushButton {
    background-color: #3c7fb1;
    border: none;
    border-radius: 4px;
    padding: 6px 12px;
    color: #ffffff;
}
QPushButton:hover {
    background-color: #559bd1;
    color: #ffffff;
}
QPushButton:pressed {
    background-color: #2a6280;
    color: #ffffff;
}
QPushButton:disabled {
    background-color: #555;
    color: #888;
}

/* controlFrame中按钮 */
QPushButton#playButton, QPushButton#stopButton, QPushButton#openButton,
QPushButton#rewindButton, QPushButton#forwardButton, QPushButton#toggleControlPanelButton {
    border: none;
    background: transparent;
    width: 32px; height: 32px;
    padding: 0px 4px;
}
QPushButton#playButton:hover, QPushButton#stopButton:hover, QPushButton#openButton:hover, 
QPushButton#rewindButton:hover, QPushButton#forwardButton:hover, QPushButton#toggleControlPanelButton:hover {
    background: rgba(60, 127, 177, 0.2);
}
QPushButton#playButton:pressed, QPushButton#stopButton:pressed, QPushButton#openButton:pressed,
QPushButton#rewindButton:pressed, QPushButton#forwardButton:pressed, QPushButton#toggleControlPanelButton:pressed {
    background: rgba(42, 98, 128, 0.3);
}
QPushButton#playButton:disabled {
    background: none;
}

/* titleBar中按钮 */
QPushButton#minimizeButton, QPushButton#maximizeButton, QPushButton#closeButton {
    background: transparent;
    border: none;
    width: 16px; height: 16px;
}
QPushButton#closeButton:hover, QPushButton#maximizeButton:hover, QPushButton#minimizeButton:hover {
    background: rgba(60, 127, 177, 0.2);
}

/* 进度条/音量滑块 */
QSlider::groove:horizontal {
    height: 6px;
    border-radius: 3px;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #3c7fb1, stop: 1 #559bd1
    );
}
QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -4px 0;
    border: 1px solid #559bd1;
    border-radius: 7px;
    background: qradialgradient(
        cx: 0.5, cy: 0.5, radius: 0.5,
        stop: 0 #ffffff, stop: 1 #3c7fb1
    );
}
QSlider::handle:horizontal:hover {
    border: 1px solid #3c7fb1;
    background: qradialgradient(
        cx: 0.5, cy: 0.5, radius: 0.5,
        stop: 0 #ffffff, stop: 1 #559bd1
    );
}
QSlider::handle:horizontal:pressed {
    border: 1px solid #2a6280;
    background: qradialgradient(
        cx: 0.5, cy: 0.5, radius: 0.5,
        stop: 0 #e0f0ff, stop: 1 #2a6280
    );
}
QSlider::groove:horizontal:disabled {
    background: #a0a0a0;
}
QSlider::handle:horizontal:disabled {
    background: #888888;
    border: 1px solid #666666;
}

/* 下拉列表 */
QComboBox {
    border: 1px solid #555;
    border-radius: 4px;
    padding: 4px 8px;
    background-color: #f2f6fa;
    color: #333;
}
QComboBox:hover {
    border-color: #3c7fb1;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 16px;
    border-left: none;
    background-color: #c8d4e0;
}
QComboBox QAbstractItemView {
    border: 1px solid #555;
    background: #f2f6fa;
    selection-background-color: #3c7fb1;
    selection-color: #333;
    color: #333;
}

/* 标签 */
QLabel#titleLabel {
    background: transparent;
    font-size: 11pt;
    color: #333;
}

/* 选项卡面板 */
QTabWidget::pane {
    border: 1px solid #3c7fb1;
    background: #c8d4e0;
}
/* 选项卡 */
QTabBar::tab {
    background: #3b3b3b;
    color: #bbb;
    padding: 6px 12px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
    font-family: "Segoe UI", "微软雅黑", Arial, sans-serif;
    font-size: 10pt;
}
QTabBar::tab:hover {
    background: #4a4a4a;
    color: #ffffff;
}
QTabBar::tab:selected {
    background: #3c7fb1;
    color: #ffffff;
    font-weight: bold;
}

/* 文本输入框和文本区域 */
QLineEdit, QTextEdit {
    background-color: #f2f6fa;
    border: 1px solid #3c7fb1;
    border-radius: 4px;
    padding: 4px;
    color: #333333;
    selection-background-color: #559bd1;
    selection-color: #ffffff;
}
QLineEdit:hover, QTextEdit:hover {
    border: 1px solid #559bd1;
}
QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #3c7fb1;
    background-color: #ffffff;
}
QLineEdit:disabled, QTextEdit:disabled {
    background-color: #e0e0e0;
    color: #888888;
    border: 1px solid #cccccc;
}